[Desktop Entry]
Version=1.0
Type=Application
Name=Install waffle-fuse
Name[it]=Installa waffle-fuse
Comment=Set up automatic mounting of Amiga and PC floppies from the DrawBridge/Waffle drive
Comment[it]=Configura il montaggio automatico dei floppy Amiga e PC dal drive DrawBridge/Waffle
Exec=sh -c "exec /usr/bin/python3 \\"\\$(dirname \\"\\$(readlink -f \\"\\$1\\")\\")/scripts/waffle-installer.py\\"" sh %k
Icon=media-floppy
Terminal=false
Categories=System;
