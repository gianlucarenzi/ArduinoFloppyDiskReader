[Desktop Entry]
Version=1.0
Type=Application
Name=Waffle DiskFlashback
Name[it]=Waffle DiskFlashback
Comment=Tray icon – mounts Amiga and PC floppies automatically when inserted in the DrawBridge/Waffle drive
Comment[it]=Icona nel tray – monta automaticamente i floppy Amiga e PC inseriti nel drive DrawBridge/Waffle
Exec=/usr/bin/python3 WAFFLE_DIR_PLACEHOLDER/scripts/waffle-diskflashback.py
Icon=ICON_PATH_PLACEHOLDER/tray-mounted.svg
Terminal=false
Categories=System;
Keywords=amiga;dos;floppy;drawbridge;waffle;tray;daemon;diskflashback;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-MATE-Autostart-enabled=true
