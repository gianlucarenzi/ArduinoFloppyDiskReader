[Desktop Entry]
Version=1.0
Type=Application
Name=Floppy disk image (waffle-fuse)
Name[it]=Immagine di floppy (waffle-fuse)
Comment=Open an Amiga ADF or PC floppy image as a virtual disk to add and remove files
Comment[it]=Apri un'immagine ADF Amiga o di floppy PC come disco virtuale per aggiungere e togliere file
Exec=/usr/bin/python3 WAFFLE_DIR_PLACEHOLDER/scripts/waffle-open-image.py %F
Icon=ICON_PATH_PLACEHOLDER/amiga-floppy.svg
Terminal=false
NoDisplay=true
MimeType=application/x-amiga-disk-image;application/x-amiga-disk-format;application/vnd.efi.img;application/x-raw-disk-image;
Categories=System;
