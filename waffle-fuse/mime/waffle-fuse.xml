<?xml version="1.0" encoding="UTF-8"?>
<!-- waffle-fuse: make sure floppy images have a type even on systems whose
     shared-mime-info has none for them (low weight: existing definitions win) -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-amiga-disk-image">
    <comment>Amiga disk image</comment>
    <comment xml:lang="it">Immagine di disco Amiga</comment>
    <generic-icon name="media-floppy"/>
    <glob pattern="*.adf" weight="40"/>
  </mime-type>
  <mime-type type="application/x-raw-disk-image">
    <comment>Raw disk image</comment>
    <comment xml:lang="it">Immagine di disco</comment>
    <generic-icon name="media-floppy"/>
    <glob pattern="*.ima" weight="40"/>
  </mime-type>
</mime-info>
